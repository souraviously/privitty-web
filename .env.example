# ============================================================
# Privitty Web — Environment Variables Reference
# ============================================================
# Copy this file to .env.local for local development.
# For AWS Amplify: set every variable in the Amplify Console
#   → App Settings → Environment Variables
#
# NEVER commit .env / .env.local to git (already in .gitignore)
# ============================================================


# ------------------------------------------------------------
# DATABASE (PostgreSQL via Prisma)
# ------------------------------------------------------------
# Full PostgreSQL connection URL.
# Options:
#   • AWS RDS PostgreSQL:  postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/DBNAME?sslmode=require
#   • Neon (serverless):   postgresql://USER:PASSWORD@ep-xxx.neon.tech/DBNAME?sslmode=require
#   • Supabase:            postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/privitty_db


# ------------------------------------------------------------
# AWS S3 — File Storage (images, PDFs, media)
# ------------------------------------------------------------
# S3 bucket name (must exist in your AWS account)
AWS_S3_BUCKET=privitty-media-bucket

# AWS region where the S3 bucket lives
AWS_REGION=us-east-1

# IAM credentials for S3 access.
# On AWS EC2 / Amplify with an attached IAM Role these can be left blank
# and the SDK will resolve credentials automatically from instance metadata.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Optional: custom CloudFront / CDN domain in front of the S3 bucket.
# If set, asset URLs will be https://<domain>/<key> instead of the default S3 URL.
# Example: cdn.privitty.com  (omit https://)
AWS_S3_CUSTOM_DOMAIN=


# ------------------------------------------------------------
# AWS S3 — PUBLIC / CLIENT-SIDE variables
# These are exposed to the browser (NEXT_PUBLIC_ prefix).
# Must match the server-side values above.
# ------------------------------------------------------------
NEXT_PUBLIC_AWS_S3_BUCKET=privitty-media-bucket
NEXT_PUBLIC_AWS_REGION=us-east-1

# Optional: same custom domain as above, for client-side asset resolution
NEXT_PUBLIC_AWS_S3_CUSTOM_DOMAIN=


# ------------------------------------------------------------
# STORAGE FALLBACK (local development only)
# ------------------------------------------------------------
# Set to "true" to write uploaded files to ./public/uploads/ instead of S3.
# Must be "false" (or unset) in production.
ENABLE_LOCAL_STORAGE_FALLBACK=false


# ------------------------------------------------------------
# ADMIN SEED CREDENTIALS
# Used only when running:  npm run db:seed
# These become the default superadmin account on first seed.
# Override before seeding in production; defaults are insecure.
# ------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@privitty.com
ADMIN_INITIAL_PASSWORD=ChangeMe_Str0ng!2026
ADMIN_INITIAL_NAME=Privitty Admin


# ------------------------------------------------------------
# NODE / NEXT.JS RUNTIME
# ------------------------------------------------------------
# Amplify sets NODE_ENV=production automatically.
# You can also increase the build heap for large projects:
# NODE_OPTIONS=--max-old-space-size=4096
NODE_ENV=production
